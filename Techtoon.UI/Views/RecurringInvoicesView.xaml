<UserControl x:Class="Techtoon.UI.Views.RecurringInvoicesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#x1F504; &#x0627;&#x0644;&#x0641;&#x0648;&#x0627;&#x062A;&#x064A;&#x0631; &#x0627;&#x0644;&#x0645;&#x062A;&#x0643;&#x0631;&#x0631;&#x0629;" FontSize="17" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="&#x1F504; &#x062A;&#x062D;&#x062F;&#x064A;&#x062B;" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding RefreshCommand}"/>
            <Button Grid.Column="2" Content="&#x2795; &#x0642;&#x0627;&#x0628;&#x0644; &#x062C;&#x062F;&#x064A;&#x062F;" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding AddCommand}"/>
            <Button Grid.Column="3" Content="&#x270F;&#xFE0F; &#x062A;&#x0639;&#x062F;&#x064A;&#x0644;" Background="#1565C0" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding EditCommand}"/>
            <Button Grid.Column="4" Content="&#x23F8; &#x062A;&#x0641;&#x0639;&#x064A;&#x0644;/&#x0625;&#x064A;&#x0642;&#x0627;&#x0641;" Background="#F57F17" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding ToggleCommand}"/>
            <Button Grid.Column="5" Content="&#x1F4E6; &#x062A;&#x0648;&#x0644;&#x064A;&#x062F; &#x0641;&#x0627;&#x062A;&#x0648;&#x0631;&#x0629; &#x0627;&#x0644;&#x0622;&#x0646;" Background="#7B1FA2" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding GenerateCommand}"/>
            <Button Grid.Column="6" Content="&#x23F3; &#x062A;&#x0648;&#x0644;&#x064A;&#x062F; &#x0627;&#x0644;&#x0645;&#x0633;&#x062A;&#x062D;&#x0642;&#x0629;" Background="#2E7D32" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding GenerateDueCommand}"/>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,6">
            <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#00695C" FontWeight="SemiBold"/>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
            <DataGrid ItemsSource="{Binding Templates}" SelectedItem="{Binding SelectedTemplate}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0642;&#x0627;&#x0628;&#x0644;" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0639;&#x0645;&#x064A;&#x0644;" Binding="{Binding PartyName}" Width="*"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0646;&#x0648;&#x0639;" Binding="{Binding TypeDisplay}" Width="80"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x062F;&#x0648;&#x0631;&#x064A;&#x0629;" Binding="{Binding FrequencyDisplay}" Width="90"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x062A;&#x0634;&#x063A;&#x064A;&#x0644; &#x0627;&#x0644;&#x062A;&#x0627;&#x0644;&#x064A;" Binding="{Binding NextRunDisplay}" Width="120"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0623;&#x0635;&#x0646;&#x0627;&#x0641;" Binding="{Binding LinesDisplay}" Width="90"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x062D;&#x0627;&#x0644;&#x0629;" Binding="{Binding StatusDisplay}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="3" Text="&#x0623;&#x0635;&#x0646;&#x0627;&#x0641; &#x0627;&#x0644;&#x0642;&#x0627;&#x0628;&#x0644; &#x0627;&#x0644;&#x0645;&#x062D;&#x062F;&#x062F;" FontSize="13" FontWeight="Bold" Foreground="#37474F" Margin="2,0,0,4"/>

        <Border Grid.Row="4" Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
            <DataGrid ItemsSource="{Binding Lines}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0635;&#x0646;&#x0641;" Binding="{Binding ItemName}" Width="*"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0628;&#x0627;&#x0631;&#x0643;&#x0648;&#x062F;" Binding="{Binding Barcode}" Width="140"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0643;&#x0645;&#x064A;&#x0629;" Binding="{Binding QuantityDisplay}" Width="100"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0633;&#x0639;&#x0631;" Binding="{Binding PriceDisplay}" Width="100"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0625;&#x062C;&#x0645;&#x0627;&#x0644;&#x064A;" Binding="{Binding TotalDisplay}" Width="110"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</UserControl>
