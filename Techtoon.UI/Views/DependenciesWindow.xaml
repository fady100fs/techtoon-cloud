<Window x:Class="Techtoon.UI.Views.DependenciesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x0627;&#x0644;&#x0633;&#x062C;&#x0644;&#x0627;&#x062A; &#x0627;&#x0644;&#x0645;&#x0631;&#x062A;&#x0628;&#x0637;&#x0629;" Height="450" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" FontFamily="Tahoma"
        FlowDirection="RightToLeft">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Margin="0,0,0,15">
            <TextBlock Text="&#x26A0;&#xFE0F; &#x0644;&#x0627; &#x064A;&#x0645;&#x0643;&#x0646; &#x062D;&#x0630;&#x0641; &#x0647;&#x0630;&#x0627; &#x0627;&#x0644;&#x0633;&#x062C;&#x0644;" FontSize="18" FontWeight="Bold" Foreground="#E53935" Margin="0,0,0,5"/>
            <TextBlock Text="&#x064A;&#x0631;&#x062C;&#x0649; &#x0627;&#x0644;&#x0636;&#x063A;&#x0637; &#x0639;&#x0644;&#x0649; &#x0623;&#x064A; &#x0633;&#x062C;&#x0644; &#x0645;&#x0631;&#x062A;&#x0628;&#x0637; &#x0644;&#x0641;&#x062A;&#x062D; &#x0635;&#x0641;&#x062D;&#x062A;&#x0647; &#x0648;&#x062A;&#x0639;&#x062F;&#x064A;&#x0644;&#x0647; &#x0623;&#x0648; &#x062D;&#x0630;&#x0641;&#x0647;:" FontSize="13" Foreground="#555" TextWrapping="Wrap"/>
        </StackPanel>

        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="5">
            <ItemsControl x:Name="LstDeps" BorderThickness="0" Background="Transparent">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Button Click="BtnOpenDep_Click" Tag="{Binding}" Background="#E3F2FD" Foreground="#1565C0" FontWeight="SemiBold" Padding="10,8" Margin="2" BorderThickness="0" Cursor="Hand" HorizontalContentAlignment="Stretch">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x1F4C4;" Margin="0,0,10,0"/>
                                <TextBlock Text="{Binding Display}"/>
                            </StackPanel>
                        </Button>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>

        <Button Grid.Row="2" x:Name="BtnClose" Content="&#x2716; &#x0625;&#x0644;&#x063A;&#x0627;&#x0621;" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="20,10" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" Margin="0,15,0,0" Click="BtnClose_Click"/>
    </Grid>
</Window>
