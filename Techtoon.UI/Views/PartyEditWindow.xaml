<Window x:Class="Techtoon.UI.Views.PartyEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding WindowTitle}" Height="740" Width="820"
        WindowStartupLocation="CenterOwner" Background="{StaticResource BackgroundBrush}" FlowDirection="RightToLeft">
    <Grid Margin="20">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="{Binding WindowTitle}" Style="{StaticResource PageTitle}"/>
        <TabControl Grid.Row="1" Background="{StaticResource BackgroundBrush}" BorderBrush="#E0E0E0">
            <TabItem Header="&#x0628;&#x064A;&#x0627;&#x0646;&#x0627;&#x062A; &#x0627;&#x0644;&#x0639;&#x0645;&#x064A;&#x0644;">
                <Border Style="{StaticResource Card}" Margin="0,10,0,0">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,15">
                                <TextBlock Text="&#x0627;&#x0644;&#x0627;&#x0633;&#x0645;:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,15">
                                <TextBlock Text="&#x0627;&#x0644;&#x0646;&#x0648;&#x0639;:" Margin="0,0,0,5"/>
                                <ComboBox SelectedValue="{Binding Type}" SelectedValuePath="Tag" Padding="8,6">
                                    <ComboBoxItem Content="&#x0639;&#x0645;&#x064A;&#x0644;" Tag="customer"/>
                                    <ComboBoxItem Content="&#x0645;&#x0648;&#x0631;&#x062F;" Tag="supplier"/>
                                    <ComboBoxItem Content="&#x0639;&#x0645;&#x064A;&#x0644; &#x0648;&#x0645;&#x0648;&#x0631;&#x062F;" Tag="both"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="&#x0627;&#x0644;&#x0647;&#x0627;&#x062A;&#x0641;:" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}" Padding="8,6"/>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="&#x0627;&#x0644;&#x0639;&#x0646;&#x0648;&#x0627;&#x0646;:" Margin="0,0,0,5"/>
                            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" AcceptsReturn="True" TextWrapping="Wrap" Height="60"/>
                        </StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,15">
                                <TextBlock Text="&#x062D;&#x062F; &#x0627;&#x0644;&#x0627;&#x0626;&#x062A;&#x0645;&#x0627;&#x0646;:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding CreditLimit, UpdateSourceTrigger=LostFocus}" Padding="8,6"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="10,0,0,15">
                                <TextBlock Text="&#x0627;&#x0644;&#x0631;&#x0635;&#x064A;&#x062F; &#x0627;&#x0644;&#x0627;&#x0641;&#x062A;&#x062A;&#x0627;&#x062D;&#x064A;:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding OpeningBalance, UpdateSourceTrigger=LostFocus}" Padding="8,6"/>
                            </StackPanel>
                        </Grid>
                        <StackPanel Margin="0,0,0,15">
                            <TextBlock Text="&#x0627;&#x0644;&#x062D;&#x0633;&#x0627;&#x0628; &#x0627;&#x0644;&#x0645;&#x0631;&#x062A;&#x0628;&#x0637;:" Margin="0,0,0,5"/>
                            <ComboBox ItemsSource="{Binding Accounts}" DisplayMemberPath="Name" SelectedItem="{Binding Account}" Padding="8,6"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </TabItem>

            <TabItem Header="&#x0633;&#x064A;&#x0627;&#x0633;&#x0627;&#x062A; &#x0627;&#x0644;&#x0639;&#x0645;&#x064A;&#x0644;">
                <Grid x:Name="PartyPolicyPanel" Margin="0,10,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="&#x0633;&#x064A;&#x0627;&#x0633;&#x0627;&#x062A; &#x0627;&#x0644;&#x0639;&#x0645;&#x064A;&#x0644;: &#x0633;&#x064A;&#x0627;&#x0633;&#x0629; &#x0627;&#x0644;&#x062E;&#x0635;&#x0645; &#x0648;&#x0627;&#x0633;&#x062A;&#x062B;&#x0646;&#x0627;&#x0621; &#x0631;&#x0633;&#x0648;&#x0645; &#x0627;&#x0644;&#x062A;&#x0623;&#x062E;&#x064A;&#x0631;" FontSize="16" FontWeight="SemiBold" Foreground="#00695C" Margin="0,0,0,8"/>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <TextBlock Foreground="#B26A00" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,10">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsPartyLoaded}" Value="False">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                                <Run Text="&#x064A;&#x062C;&#x0628; &#x062D;&#x0641;&#x0638; &#x0628;&#x064A;&#x0627;&#x0646;&#x0627;&#x062A; &#x0627;&#x0644;&#x0639;&#x0645;&#x064A;&#x0644; &#x0623;&#x0648;&#x0644;&#x0627;&#x064B;&#x060C; &#x062B;&#x0645; &#x0625;&#x0639;&#x0627;&#x062F;&#x0629; &#x0641;&#x062A;&#x062D;&#x0647; &#x0644;&#x062A;&#x062E;&#x0635;&#x064A;&#x0635; &#x0627;&#x0644;&#x0633;&#x064A;&#x0627;&#x0633;&#x0627;&#x062A;."/>
                            </TextBlock>

                            <StackPanel IsEnabled="{Binding IsPartyLoaded}">
                                <!-- ============ سياسة الخصم ============ -->
                                <Border Style="{StaticResource Card}" Padding="15" Margin="0,0,0,12">
                                    <StackPanel>
                                        <TextBlock Text="&#x0633;&#x064A;&#x0627;&#x0633;&#x0629; &#x0627;&#x0644;&#x062E;&#x0635;&#x0645;" FontSize="15" FontWeight="SemiBold" Foreground="#00695C" Margin="0,0,0,8"/>
                                        <DataGrid ItemsSource="{Binding DiscountPolicies}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="12" MaxHeight="180"
                                                  AlternatingRowBackground="#FAFAFA">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0633;&#x064A;&#x0627;&#x0633;&#x0629;" Binding="{Binding PolicyNameDisplay}" Width="*"/>
                                                <DataGridTextColumn Header="&#x0646;&#x0648;&#x0639; &#x0627;&#x0644;&#x062E;&#x0635;&#x0645;" Binding="{Binding PolicyTypeDisplay}" Width="110"/>
                                                <DataGridTextColumn Header="&#x0642;&#x064A;&#x0645;&#x0629; &#x0627;&#x0644;&#x0633;&#x064A;&#x0627;&#x0633;&#x0629;" Binding="{Binding PolicyDefaultValueDisplay}" Width="100"/>
                                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x062E;&#x0635;&#x0645; &#x0627;&#x0644;&#x0645;&#x062E;&#x0635;&#x0635;" Binding="{Binding CustomDiscountValueDisplay}" Width="100"/>
                                                <DataGridTextColumn Header="&#x0623;&#x064A;&#x0627;&#x0645; &#x0627;&#x0644;&#x0623;&#x0647;&#x0644;&#x064A;&#x0629;" Binding="{Binding CustomEligibilityDaysDisplay}" Width="100"/>
                                                <DataGridTextColumn Header="&#x0645;&#x0644;&#x0627;&#x062D;&#x0638;&#x0627;&#x062A;" Binding="{Binding NotesDisplay}" Width="*"/>
                                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x062D;&#x0627;&#x0644;&#x0629;" Binding="{Binding StatusDisplay}" Width="80"/>
                                                <DataGridTemplateColumn Header="&#x0625;&#x0632;&#x0627;&#x0644;&#x0629;" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="&#x0625;&#x0632;&#x0627;&#x0644;&#x0629;" Padding="6,2" FontSize="11"
                                                                    Command="{Binding DataContext.RemoveDiscountCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="&#x0633;&#x064A;&#x0627;&#x0633;&#x0629; &#x0627;&#x0644;&#x062E;&#x0635;&#x0645;:" VerticalAlignment="Center" Margin="0,4"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableDiscountPolicies}"
                                                      DisplayMemberPath="Display" SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedDiscountPolicyId}" Padding="6,4" Margin="0,4"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="&#x0642;&#x064A;&#x0645;&#x0629; &#x0627;&#x0644;&#x062E;&#x0635;&#x0645; &#x0627;&#x0644;&#x0645;&#x062E;&#x0635;&#x0635;&#x0629;:" VerticalAlignment="Center" Margin="0,4"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CustomDiscountValueText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,4"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="&#x0645;&#x062F;&#x0629; &#x0627;&#x0644;&#x0623;&#x0647;&#x0644;&#x064A;&#x0629; &#x0627;&#x0644;&#x0645;&#x062E;&#x0635;&#x0635;&#x0629; (&#x0623;&#x064A;&#x0627;&#x0645;):" VerticalAlignment="Center" Margin="0,4"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomEligibilityDaysText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,4"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="&#x0645;&#x0644;&#x0627;&#x062D;&#x0638;&#x0627;&#x062A;:" VerticalAlignment="Center" Margin="0,4"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding DiscountNotes, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,4"/>

                                            <Button Grid.Row="4" Grid.Column="1" Content="&#x062A;&#x0639;&#x064A;&#x064A;&#x0646; / &#x062A;&#x062D;&#x062F;&#x064A;&#x062B; &#x0633;&#x064A;&#x0627;&#x0633;&#x0629; &#x0627;&#x0644;&#x062E;&#x0635;&#x0645;" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding AssignDiscountCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="18,7"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- ============ استثناء رسوم التأخير ============ -->
                                <Border Style="{StaticResource Card}" Padding="15">
                                    <StackPanel>
                                        <TextBlock Text="&#x0627;&#x0633;&#x062A;&#x062B;&#x0646;&#x0627;&#x0621; &#x0631;&#x0633;&#x0648;&#x0645; &#x0627;&#x0644;&#x062A;&#x0623;&#x062E;&#x064A;&#x0631;" FontSize="15" FontWeight="SemiBold" Foreground="#00695C" Margin="0,0,0,8"/>
                                        <DataGrid ItemsSource="{Binding LateFeeExceptions}" AutoGenerateColumns="False" IsReadOnly="True"
                                                  CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                  HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="12" MaxHeight="180"
                                                  AlternatingRowBackground="#FAFAFA">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0633;&#x064A;&#x0627;&#x0633;&#x0629;" Binding="{Binding PolicyNameDisplay}" Width="*"/>
                                                <DataGridTextColumn Header="&#x0646;&#x0648;&#x0639; &#x0627;&#x0644;&#x0627;&#x0633;&#x062A;&#x062B;&#x0646;&#x0627;&#x0621;" Binding="{Binding ExceptionTypeDisplay}" Width="140"/>
                                                <DataGridTextColumn Header="&#x0642;&#x064A;&#x0645;&#x0629; &#x0645;&#x062E;&#x0635;&#x0635;&#x0629;" Binding="{Binding CustomFeeValueDisplay}" Width="100"/>
                                                <DataGridTextColumn Header="&#x0633;&#x0645;&#x0627;&#x062D; &#x0645;&#x062E;&#x0635;&#x0635;" Binding="{Binding CustomGraceDaysDisplay}" Width="100"/>
                                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0633;&#x0628;&#x0628;" Binding="{Binding ReasonDisplay}" Width="*"/>
                                                <DataGridTextColumn Header="&#x062A;&#x0646;&#x062A;&#x0647;&#x064A; &#x0641;&#x064A;" Binding="{Binding ExpiresAtDisplay}" Width="100"/>
                                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x062D;&#x0627;&#x0644;&#x0629;" Binding="{Binding StatusDisplay}" Width="80"/>
                                                <DataGridTemplateColumn Header="&#x0625;&#x0632;&#x0627;&#x0644;&#x0629;" Width="80">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Button Content="&#x0625;&#x0632;&#x0627;&#x0644;&#x0629;" Padding="6,2" FontSize="11"
                                                                    Command="{Binding DataContext.RemoveExceptionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>

                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="&#x0633;&#x064A;&#x0627;&#x0633;&#x0629; &#x0631;&#x0633;&#x0648;&#x0645; &#x0627;&#x0644;&#x062A;&#x0623;&#x062E;&#x064A;&#x0631;:" VerticalAlignment="Center" Margin="0,4"/>
                                            <ComboBox Grid.Row="0" Grid.Column="1" ItemsSource="{Binding AvailableLateFeePolicies}"
                                                      DisplayMemberPath="Display" SelectedValuePath="Id"
                                                      SelectedValue="{Binding SelectedExceptionPolicyId}" Padding="6,4" Margin="0,4"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="&#x0646;&#x0648;&#x0639; &#x0627;&#x0644;&#x0627;&#x0633;&#x062A;&#x062B;&#x0646;&#x0627;&#x0621;:" VerticalAlignment="Center" Margin="0,4"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding ExceptionTypes}"
                                                      DisplayMemberPath="Display" SelectedValuePath="Value"
                                                      SelectedValue="{Binding SelectedExceptionType}" Padding="6,4" Margin="0,4"/>

                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="&#x0642;&#x064A;&#x0645;&#x0629; &#x0627;&#x0644;&#x0631;&#x0633;&#x0648;&#x0645; &#x0627;&#x0644;&#x0645;&#x062E;&#x0635;&#x0635;&#x0629;:" VerticalAlignment="Center" Margin="0,4"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding CustomFeeValueText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,4"/>

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="&#x0641;&#x062A;&#x0631;&#x0629; &#x0627;&#x0644;&#x0633;&#x0645;&#x0627;&#x062D; &#x0627;&#x0644;&#x0645;&#x062E;&#x0635;&#x0635;&#x0629; (&#x0623;&#x064A;&#x0627;&#x0645;):" VerticalAlignment="Center" Margin="0,4"/>
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding CustomGraceDaysText, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,4"/>

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="&#x0633;&#x0628;&#x0628; &#x0627;&#x0644;&#x0627;&#x0633;&#x062A;&#x062B;&#x0646;&#x0627;&#x0621;:" VerticalAlignment="Center" Margin="0,4"/>
                                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ExceptionReason, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" Margin="0,4"/>

                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="&#x062A;&#x0646;&#x062A;&#x0647;&#x064A; &#x0635;&#x0644;&#x0627;&#x062D;&#x064A;&#x062A;&#x0647;&#x0627; &#x0641;&#x064A;:" VerticalAlignment="Center" Margin="0,4"/>
                                            <DatePicker Grid.Row="5" Grid.Column="1" SelectedDate="{Binding ExpiresAt}" Padding="6,4" Margin="0,4" Width="180" HorizontalAlignment="Right"/>

                                            <Button Grid.Row="6" Grid.Column="1" Content="&#x062A;&#x0639;&#x064A;&#x064A;&#x0646; / &#x062A;&#x062D;&#x062F;&#x064A;&#x062B; &#x0627;&#x0644;&#x0627;&#x0633;&#x062A;&#x062B;&#x0646;&#x0627;&#x0621;" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding AssignExceptionCommand}" HorizontalAlignment="Right" Margin="0,8,0,0" Padding="18,7"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                </Grid>
            </TabItem>
        </TabControl>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center" Margin="0,0,20,0" TextWrapping="Wrap" MaxWidth="350"/>
            <Button Content="&#x0625;&#x0644;&#x063A;&#x0627;&#x0621;" Style="{StaticResource PrimaryButton}" Command="{Binding CancelCommand}" Background="#757575" Margin="0,0,10,0"/>
            <Button Content="&#x1F4BE; &#x062D;&#x0641;&#x0638;" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
