<UserControl x:Class="Techtoon.UI.Views.AccountingPeriodsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#x1F4C5; &#x0627;&#x0644;&#x0641;&#x062A;&#x0631;&#x0627;&#x062A; &#x0627;&#x0644;&#x0645;&#x062D;&#x0627;&#x0633;&#x0628;&#x064A;&#x0629;" FontSize="20" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="&#x1F504; &#x062A;&#x062D;&#x062F;&#x064A;&#x062B;" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding RefreshCommand}"/>
            <Button Grid.Column="2" Content="&#x2795; &#x0625;&#x0636;&#x0627;&#x0641;&#x0629;" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding AddCommand}"/>
            <Button Grid.Column="3" Content="&#x270F;&#xFE0F; &#x062A;&#x0639;&#x062F;&#x064A;&#x0644;" Background="#1565C0" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding EditCommand}"/>
            <Button Grid.Column="4" Content="&#x1F512; &#x0625;&#x063A;&#x0644;&#x0627;&#x0642;" Background="#7B1FA2" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding CloseCommand}"/>
            <Button Grid.Column="5" Content="&#x1F5D1;&#xFE0F; &#x062D;&#x0630;&#x0641;" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding DeleteCommand}"/>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x1F50D; &#x0628;&#x062D;&#x062B;:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" Padding="6,4" BorderBrush="#B0BEC5" BorderThickness="1"/>
                <TextBlock Grid.Column="2" Text="&#x0627;&#x0644;&#x0641;&#x062A;&#x0631;&#x0629; &#x0627;&#x0644;&#x0645;&#x063A;&#x0644;&#x0642;&#x0629; &#x062A;&#x0645;&#x0646;&#x0639; &#x062D;&#x0641;&#x0638; &#x0623;&#x064A; &#x0645;&#x0633;&#x062A;&#x0646;&#x062F; &#x0628;&#x062A;&#x0627;&#x0631;&#x064A;&#x062E; &#x062F;&#x0627;&#x062E;&#x0644;&#x0647;&#x0627;" Foreground="#C62828" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="12"/>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="DgPeriods" ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13" AlternatingRowBackground="#FAFAFA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0627;&#x0633;&#x0645;" Binding="{Binding PeriodName}" Width="*"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0628;&#x062F;&#x0627;&#x064A;&#x0629;" Binding="{Binding StartDateDisplay}" Width="105"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0646;&#x0647;&#x0627;&#x064A;&#x0629;" Binding="{Binding EndDateDisplay}" Width="105"/>
                    <DataGridTextColumn Header="&#x0633;&#x0646;&#x0629; &#x0645;&#x0627;&#x0644;&#x064A;&#x0629;" Binding="{Binding FiscalYearDisplay}" Width="90"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x062D;&#x0627;&#x0644;&#x0629;" Binding="{Binding StatusDisplay}" Width="90"/>
                    <DataGridTextColumn Header="&#x062A;&#x0627;&#x0631;&#x064A;&#x062E; &#x0627;&#x0644;&#x0625;&#x063A;&#x0644;&#x0627;&#x0642;" Binding="{Binding ClosingDateDisplay}" Width="140"/>
                    <DataGridTextColumn Header="&#x0645;&#x0644;&#x0627;&#x062D;&#x0638;&#x0627;&#x062A; &#x0627;&#x0644;&#x0625;&#x063A;&#x0644;&#x0627;&#x0642;" Binding="{Binding ClosingNotes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="0" Grid.RowSpan="3" Text="{Binding StatusMessage}" FontSize="12" Foreground="#00897B" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,5"/>
    </Grid>
</UserControl>
