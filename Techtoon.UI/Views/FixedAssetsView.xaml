<UserControl x:Class="Techtoon.UI.Views.FixedAssetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="220"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#x1F3ED; &#x627;&#x644;&#x623;&#x635;&#x648;&#x644; &#x627;&#x644;&#x62B;&#x627;&#x628;&#x62A;&#x629; &#x648;&#x627;&#x644;&#x625;&#x647;&#x644;&#x627;&#x643;" FontSize="20" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="&#x1F504; &#x62A;&#x62D;&#x62F;&#x64A;&#x62B;" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding RefreshCommand}"/>
            <Button Grid.Column="2" Content="&#x2795; &#x625;&#x636;&#x627;&#x641;&#x629; &#x623;&#x635;&#x644;" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding AddCommand}"/>
            <Button Grid.Column="3" Content="&#x270F;&#xFE0F; &#x62A;&#x639;&#x62F;&#x64A;&#x644;" Background="#1565C0" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding EditCommand}"/>
            <Button Grid.Column="4" Content="&#x1F5D1;&#xFE0F; &#x62D;&#x630;&#x641;" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding DeleteCommand}"/>
            <Button Grid.Column="5" Content="&#x1F4DC; &#x633;&#x62C;&#x644; &#x627;&#x644;&#x625;&#x647;&#x644;&#x627;&#x643;" Background="#6A1B9A" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding HistoryCommand}"/>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F50D; &#x628;&#x62D;&#x62B;:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" Padding="6,4" BorderBrush="#B0BEC5" BorderThickness="1"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="DgAssets" ItemsSource="{Binding Assets}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13" AlternatingRowBackground="#FAFAFA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x643;&#x648;&#x62F;" Binding="{Binding Code}" Width="90"/>
                    <DataGridTextColumn Header="&#x627;&#x633;&#x645; &#x627;&#x644;&#x623;&#x635;&#x644;" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x62A;&#x635;&#x646;&#x64A;&#x641;" Binding="{Binding Category}" Width="130"/>
                    <DataGridTextColumn Header="&#x62A;&#x627;&#x631;&#x64A;&#x62E; &#x627;&#x644;&#x634;&#x631;&#x627;&#x621;" Binding="{Binding PurchaseDateDisplay}" Width="110"/>
                    <DataGridTextColumn Header="&#x62A;&#x643;&#x644;&#x641;&#x629; &#x627;&#x644;&#x634;&#x631;&#x627;&#x621;" Binding="{Binding PurchaseCostDisplay}" Width="120"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x642;&#x64A;&#x645;&#x629; &#x627;&#x644;&#x645;&#x62A;&#x628;&#x642;&#x64A;&#x629;" Binding="{Binding SalvageDisplay}" Width="120"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x639;&#x645;&#x631; (&#x633;&#x646;&#x629;)" Binding="{Binding UsefulLifeYears}" Width="90"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x625;&#x647;&#x644;&#x627;&#x643; &#x627;&#x644;&#x634;&#x647;&#x631;&#x64A;" Binding="{Binding MonthlyDisplay}" Width="120"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x625;&#x647;&#x644;&#x627;&#x643; &#x627;&#x644;&#x645;&#x62A;&#x631;&#x627;&#x643;&#x645;" Binding="{Binding AccumulatedDisplay}" Width="130"/>
                    <DataGridTextColumn Header="&#x635;&#x627;&#x641;&#x64A; &#x627;&#x644;&#x642;&#x64A;&#x645;&#x629; &#x627;&#x644;&#x62F;&#x641;&#x62A;&#x631;&#x64A;&#x629;" Binding="{Binding NetBookDisplay}" Width="150"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x645;&#x648;&#x642;&#x639;" Binding="{Binding Location}" Width="110"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x645;&#x633;&#x624;&#x648;&#x644;" Binding="{Binding ResponsiblePerson}" Width="110"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x62D;&#x627;&#x644;&#x629;" Binding="{Binding StatusDisplay}" Width="120"/>
                    <DataGridTemplateColumn Header="&#x625;&#x647;&#x644;&#x627;&#x643;" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="&#x1F4C9; &#x625;&#x647;&#x644;&#x627;&#x643;" Background="#EF6C00" Foreground="White" FontWeight="SemiBold" BorderThickness="0" FontSize="12" Cursor="Hand" Padding="6,3"
                                        Command="{Binding DataContext.DepreciateCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"/>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,5">
            <TextBlock Text="{Binding HistoryTitle}" FontSize="14" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="DgDepreciation" ItemsSource="{Binding DepreciationHistory}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13" AlternatingRowBackground="#FAFAFA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x62A;&#x627;&#x631;&#x64A;&#x62E;" Binding="{Binding DateDisplay}" Width="120"/>
                    <DataGridTextColumn Header="&#x645;&#x628;&#x644;&#x63A; &#x627;&#x644;&#x625;&#x647;&#x644;&#x627;&#x643;" Binding="{Binding AmountDisplay}" Width="140"/>
                    <DataGridTextColumn Header="&#x627;&#x644;&#x625;&#x647;&#x644;&#x627;&#x643; &#x627;&#x644;&#x645;&#x62A;&#x631;&#x627;&#x643;&#x645;" Binding="{Binding AccumulatedDisplay}" Width="150"/>
                    <DataGridTextColumn Header="&#x635;&#x627;&#x641;&#x64A; &#x627;&#x644;&#x642;&#x64A;&#x645;&#x629; &#x627;&#x644;&#x62F;&#x641;&#x62A;&#x631;&#x64A;&#x629;" Binding="{Binding NetBookDisplay}" Width="170"/>
                    <DataGridTextColumn Header="&#x645;&#x644;&#x627;&#x62D;&#x638;&#x627;&#x62A;" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="0" Grid.RowSpan="5" Text="{Binding StatusMessage}" FontSize="12" Foreground="#00897B" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,5"/>
    </Grid>
</UserControl>
