<Window x:Class="Techtoon.UI.Views.ItemEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x0635;&#x0646;&#x0641;" Height="750" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" FontFamily="Tahoma"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock x:Name="LblTitle" Grid.Row="0" FontSize="20" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,15"/>

        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock x:Name="LblName" Text="&#x0627;&#x0644;&#x0627;&#x0633;&#x0645;:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtName" Padding="6,4" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="1" Margin="0,0,10,10">
                    <TextBlock x:Name="LblBarcode" Text="&#x0628;&#x0627;&#x0631;&#x0643;&#x0648;&#x062F;:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtBarcode" Padding="6,4" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Row="0" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock x:Name="LblCategory" Text="&#x0627;&#x0644;&#x062A;&#x0635;&#x0646;&#x064A;&#x0641;:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <ComboBox x:Name="CmbCategory" Padding="6,4" FontSize="14" DisplayMemberPath="Name" SelectedValuePath="Id"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock x:Name="LblSellPrice" Text="&#x0633;&#x0639;&#x0631; &#x0627;&#x0644;&#x0628;&#x064A;&#x0639;:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtSellPrice" Padding="6,4" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,0,10,10">
                    <TextBlock x:Name="LblCostPrice" Text="&#x0627;&#x0644;&#x062A;&#x0643;&#x0644;&#x0641;&#x0629;:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtCostPrice" Padding="6,4" FontSize="14" IsReadOnly="True" Background="#F0F0F0"/>
                </StackPanel>

                <StackPanel Grid.Row="1" Grid.Column="2" Margin="0,0,0,10">
                    <TextBlock x:Name="LblMinStock" Text="&#x0627;&#x0644;&#x062D;&#x062F; &#x0627;&#x0644;&#x0623;&#x062F;&#x0646;&#x0649;:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtMinStock" Padding="6,4" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="0" Margin="0,0,10,10">
                    <TextBlock x:Name="LblOpeningQty" Text="&#x0627;&#x0644;&#x0631;&#x0635;&#x064A;&#x062F; &#x0627;&#x0644;&#x0627;&#x0641;&#x062A;&#x062A;&#x0627;&#x062D;&#x064A;:" FontWeight="SemiBold" Margin="0,0,0,5"/>
                    <TextBox x:Name="TxtOpeningQty" Padding="6,4" FontSize="14"/>
                </StackPanel>

                <StackPanel Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" VerticalAlignment="Center" Margin="0,10,0,10">
                    <CheckBox x:Name="ChkActive" Content="&#x0646;&#x0634;&#x0637;" FontSize="14" VerticalAlignment="Center"/>
                </StackPanel>

                <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Background="#E0F2F1" CornerRadius="4" Padding="10" Margin="0,5,0,0">
                    <StackPanel Orientation="Horizontal">
                        <CheckBox x:Name="ChkIsKit" Content="&#x0639;&#x0644;&#x0627;&#x0645;&#x0629;: &#x0647;&#x0630;&#x0627; &#x0627;&#x0644;&#x0635;&#x0646;&#x0641; &#x0643;&#x064A; (&#x0645;&#x062C;&#x0645;&#x0648;&#x0639;&#x0629;)" FontSize="14" FontWeight="SemiBold" Foreground="#00695C" VerticalAlignment="Center" Checked="ChkIsKit_Changed" Unchecked="ChkIsKit_Changed"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border x:Name="KitComponentsSection" Grid.Row="2" Background="White" CornerRadius="6" Padding="15" Margin="0,0,0,10" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="&#x0645;&#x0643;&#x0648;&#x0646;&#x0627;&#x062A; &#x0627;&#x0644;&#x0643;&#x064A;&#x062A;" FontSize="16" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <TextBlock Text="&#x0627;&#x062E;&#x062A;&#x0631; &#x0627;&#x0644;&#x0635;&#x0646;&#x0641; &#x0627;&#x0644;&#x0645;&#x0643;&#x0648;&#x0646;:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <ComboBox x:Name="CmbComponent" Padding="6,4" FontSize="14" DisplayMemberPath="DisplayText" SelectedValuePath="Id"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,10,0">
                        <TextBlock Text="&#x0627;&#x0644;&#x0643;&#x0645;&#x064A;&#x0629;:" FontWeight="SemiBold" Margin="0,0,0,3"/>
                        <TextBox x:Name="TxtComponentQty" Padding="6,4" FontSize="14" Text="1"/>
                    </StackPanel>

                    <Button x:Name="BtnAddComponent" Grid.Column="2" Content="&#x0625;&#x0636;&#x0627;&#x0641;&#x0629;" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="15,8" BorderThickness="0" Cursor="Hand" VerticalAlignment="Bottom" Click="BtnAddComponent_Click"/>
                </Grid>

                <Border Background="#FAFAFA" CornerRadius="4" Padding="3" Margin="0,0,0,10">
                    <DataGrid x:Name="DgKitComponents" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13" MinHeight="120" MaxHeight="200">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="&#x0627;&#x0644;&#x0635;&#x0646;&#x0641; &#x0627;&#x0644;&#x0645;&#x0643;&#x0648;&#x0646;" Binding="{Binding ComponentName}" Width="*"/>
                            <DataGridTextColumn Header="&#x0627;&#x0644;&#x0643;&#x0645;&#x064A;&#x0629;" Binding="{Binding Quantity, StringFormat=N2}" Width="100"/>
                            <DataGridTextColumn Header="&#x062A;&#x0643;&#x0644;&#x0641;&#x0629; &#x0627;&#x0644;&#x0648;&#x062D;&#x062F;&#x0629;" Binding="{Binding UnitCost, StringFormat=N2}" Width="120"/>
                            <DataGridTextColumn Header="&#x0627;&#x0644;&#x0625;&#x062C;&#x0645;&#x0627;&#x0644;&#x064A;" Binding="{Binding TotalCost, StringFormat=N2}" Width="120"/>
                            <DataGridTemplateColumn Header="&#x062D;&#x0630;&#x0641;" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="&#x2716;" Background="#E53935" Foreground="White" Padding="5,3" BorderThickness="0" Cursor="Hand" Click="BtnRemoveComponent_Click" Tag="{Binding Id}"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Background="#E0F2F1" CornerRadius="4" Padding="10">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                        <TextBlock Text="&#x0625;&#x062C;&#x0645;&#x0627;&#x0644;&#x064A; &#x062A;&#x0643;&#x0644;&#x0641;&#x0629; &#x0627;&#x0644;&#x0643;&#x064A;&#x062A;: " FontSize="14" FontWeight="Bold" Foreground="#00695C"/>
                        <TextBlock x:Name="LblTotalKitCost" Text="0.00" FontSize="16" FontWeight="Bold" Foreground="#00695C" Margin="10,0,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="BtnSave" Content="&#x1F4BE; &#x062D;&#x0641;&#x0638;" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" Click="BtnSave_Click"/>
            <Button x:Name="BtnDelete" Content="&#x1F5D1;&#xFE0F; &#x062D;&#x0630;&#x0641;" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" Click="BtnDelete_Click"/>
            <Button x:Name="BtnCancel" Content="&#x2716; &#x0625;&#x0644;&#x063A;&#x0627;&#x0621;" Background="#757575" Foreground="White" FontWeight="SemiBold" Padding="20,10" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>

        <TextBlock x:Name="LblStatus" Grid.Row="5" FontSize="13" Foreground="#E53935" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>
