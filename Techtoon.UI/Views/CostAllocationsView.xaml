<UserControl x:Class="Techtoon.UI.Views.CostAllocationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#x1F4CA; &#x062A;&#x0648;&#x0632;&#x064A;&#x0639; &#x0627;&#x0644;&#x062A;&#x0643;&#x0627;&#x0644;&#x064A;&#x0641; &#x0648;&#x062D;&#x0631;&#x0643;&#x0627;&#x062A; &#x0645;&#x0631;&#x0627;&#x0643;&#x0632; &#x0627;&#x0644;&#x062A;&#x0643;&#x0644;&#x0641;&#x0629;" FontSize="20" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="&#x1F504; &#x062A;&#x062D;&#x062F;&#x064A;&#x062B;" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Command="{Binding RefreshCommand}"/>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="&#x1F3AF; &#x0645;&#x0631;&#x0643;&#x0632; &#x0627;&#x0644;&#x062A;&#x0643;&#x0644;&#x0641;&#x0629;:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding CostCenters}" SelectedItem="{Binding SelectedCostCenter}" DisplayMemberPath="Display" MinWidth="320" Padding="6,4" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" Margin="16,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#x0635;&#x0627;&#x0641;&#x064A; &#x0627;&#x0644;&#x062A;&#x0643;&#x0644;&#x0641;&#x0629;:" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <TextBlock Text="{Binding SelectedNetDisplay}" FontSize="15" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="2" Background="Transparent">

            <!-- ============ تبويب: توزيع التكاليف ============ -->
            <TabItem Header="&#x1F4CB; &#x062A;&#x0648;&#x0632;&#x064A;&#x0639; &#x0627;&#x0644;&#x062A;&#x0643;&#x0627;&#x0644;&#x064A;&#x0641;" FontSize="14" FontWeight="Bold">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#x2795; &#x0625;&#x0636;&#x0627;&#x0641;&#x0629;" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="12,7" Margin="3,0" Command="{Binding AddAllocationCommand}"/>
                        <Button Grid.Column="1" Content="&#x270F;&#xFE0F; &#x062A;&#x0639;&#x062F;&#x064A;&#x0644;" Background="#1565C0" Foreground="White" FontWeight="SemiBold" Padding="12,7" Margin="3,0" Command="{Binding EditAllocationCommand}"/>
                        <Button Grid.Column="2" Content="&#x1F5D1;&#xFE0F; &#x062D;&#x0630;&#x0641;" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="12,7" Margin="3,0" Command="{Binding DeleteAllocationCommand}"/>
                    </Grid>
                    <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <DataGrid ItemsSource="{Binding Allocations}" SelectedItem="{Binding SelectedAllocation}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13" AlternatingRowBackground="#FAFAFA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x062D;&#x0633;&#x0627;&#x0628;" Binding="{Binding AccountDisplay}" Width="*"/>
                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0646;&#x0633;&#x0628;&#x0629;" Binding="{Binding PercentageDisplay}" Width="90"/>
                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0634;&#x0647;&#x0631; / &#x0627;&#x0644;&#x0633;&#x0646;&#x0629;" Binding="{Binding PeriodDisplay}" Width="110"/>
                                <DataGridTextColumn Header="&#x0645;&#x0644;&#x0627;&#x062D;&#x0638;&#x0627;&#x062A;" Binding="{Binding Notes}" Width="*"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ تبويب: حركات مركز التكلفة ============ -->
            <TabItem Header="&#x1F4B3; &#x062D;&#x0631;&#x0643;&#x0627;&#x062A; &#x0645;&#x0631;&#x0643;&#x0632; &#x0627;&#x0644;&#x062A;&#x0643;&#x0644;&#x0641;&#x0629;" FontSize="14" FontWeight="Bold">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" Content="&#x2795; &#x0625;&#x0636;&#x0627;&#x0641;&#x0629;" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="12,7" Margin="3,0" Command="{Binding AddTransactionCommand}"/>
                        <Button Grid.Column="1" Content="&#x270F;&#xFE0F; &#x062A;&#x0639;&#x062F;&#x064A;&#x0644;" Background="#1565C0" Foreground="White" FontWeight="SemiBold" Padding="12,7" Margin="3,0" Command="{Binding EditTransactionCommand}"/>
                        <Button Grid.Column="2" Content="&#x1F5D1;&#xFE0F; &#x062D;&#x0630;&#x0641;" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="12,7" Margin="3,0" Command="{Binding DeleteTransactionCommand}"/>
                    </Grid>
                    <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <DataGrid ItemsSource="{Binding Transactions}" SelectedItem="{Binding SelectedTransaction}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13" AlternatingRowBackground="#FAFAFA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x062A;&#x0627;&#x0631;&#x064A;&#x062E;" Binding="{Binding DateDisplay}" Width="100"/>
                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0648;&#x0635;&#x0641;" Binding="{Binding Description}" Width="*"/>
                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0646;&#x0648;&#x0639;" Binding="{Binding TypeDisplay}" Width="150"/>
                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0645;&#x0628;&#x0644;&#x063A;" Binding="{Binding AmountDisplay}" Width="120"/>
                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0645;&#x0631;&#x062C;&#x0639;" Binding="{Binding ReferenceDisplay}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ تبويب: ملخص مراكز التكلفة ============ -->
            <TabItem Header="&#x1F4CA; &#x0645;&#x0644;&#x062E;&#x0635; &#x0645;&#x0631;&#x0627;&#x0643;&#x0632; &#x0627;&#x0644;&#x062A;&#x0643;&#x0644;&#x0641;&#x0629;" FontSize="14" FontWeight="Bold">
                <Grid Margin="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="&#x0627;&#x0644;&#x0635;&#x0627;&#x0641;&#x064A; = &#x0645;&#x062C;&#x0645;&#x0648;&#x0639; &#x0627;&#x0644;&#x0645;&#x062F;&#x064A;&#x0646; &#x2212; &#x0645;&#x062C;&#x0645;&#x0648;&#x0639; &#x0627;&#x0644;&#x062F;&#x0627;&#x0626;&#x0646;" FontSize="13" Foreground="#00695C" Margin="0,0,0,8" VerticalAlignment="Center"/>
                    <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <DataGrid ItemsSource="{Binding Summary}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13" AlternatingRowBackground="#FAFAFA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="55"/>
                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0643;&#x0648;&#x062F;" Binding="{Binding Code}" Width="110"/>
                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0627;&#x0633;&#x0645;" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="&#x0625;&#x062C;&#x0645;&#x0627;&#x0644;&#x064A; &#x0627;&#x0644;&#x0645;&#x062F;&#x064A;&#x0646;" Binding="{Binding DebitDisplay}" Width="130"/>
                                <DataGridTextColumn Header="&#x0625;&#x062C;&#x0645;&#x0627;&#x0644;&#x064A; &#x0627;&#x0644;&#x062F;&#x0627;&#x0626;&#x0646;" Binding="{Binding CreditDisplay}" Width="130"/>
                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0635;&#x0627;&#x0641;&#x064A;" Binding="{Binding NetDisplay}" Width="130"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="0" Grid.RowSpan="3" Text="{Binding StatusMessage}" FontSize="12" Foreground="#00897B" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,5"/>
    </Grid>
</UserControl>
