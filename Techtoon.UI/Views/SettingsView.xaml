<UserControl x:Class="Techtoon.UI.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <Grid Margin="20">
        <Border Background="White" CornerRadius="8" Padding="18" BorderBrush="#E0E0E0" BorderThickness="1"
                HorizontalAlignment="Center" Width="620" VerticalAlignment="Top">
            <StackPanel>

                <TextBlock x:Name="LblTitle" FontSize="24" FontWeight="Bold" Foreground="#00695C" HorizontalAlignment="Center" Margin="0,0,0,16"/>

                <TabControl SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

                    <!-- ===================== تبويب النسخ الاحتياطي ===================== -->
                    <TabItem x:Name="TabBackup" Header="النسخ الاحتياطي">
                        <StackPanel Margin="16">
                            <TextBlock x:Name="LblBackup" FontSize="16" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,10"/>
                            <Button x:Name="BtnBackup" Background="#00897B" Foreground="White" FontWeight="SemiBold" FontSize="14" Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,0,10" Command="{Binding BackupCommand}"/>
                            <Button x:Name="BtnRestore" Background="#FB8C00" Foreground="White" FontWeight="SemiBold" FontSize="14" Padding="20,10" BorderThickness="0" Cursor="Hand" Command="{Binding RestoreCommand}"/>
                        </StackPanel>
                    </TabItem>

                    <!-- ===================== تبويب تفعيل البرنامج ===================== -->
                    <TabItem x:Name="TabLicense" Header="تفعيل البرنامج">
                        <StackPanel Margin="16">

                            <TextBlock x:Name="LblLicenseHeader" FontSize="16" FontWeight="Bold" Foreground="#37474F" Margin="0,0,0,4"/>
                            <TextBlock x:Name="LblLicenseHint" FontSize="12" Foreground="#607D8B" TextWrapping="Wrap" Margin="0,0,0,14"/>

                            <Border Background="#F5F7FA" CornerRadius="6" Padding="14" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,14">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="الحالة:" Foreground="#546E7A" Margin="0,3"/>
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding License.LicenseStateText}" FontWeight="Bold" Foreground="#00695C" Margin="0,3"/>

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="نوع الترخيص:" Foreground="#546E7A" Margin="0,3"/>
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding License.LicenseTypeText}" Margin="0,3"/>

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="صادرة لـ:" Foreground="#546E7A" Margin="0,3"/>
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding License.LicenseOwnerText}" Margin="0,3"/>

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="تنتهي في:" Foreground="#546E7A" Margin="0,3"/>
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding License.LicenseExpiryText}" Margin="0,3"/>

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="ملف الترخيص:" Foreground="#546E7A" Margin="0,3"/>
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding License.LicensePathText}" Margin="0,3" TextWrapping="Wrap" FontSize="11"/>
                                </Grid>
                            </Border>

                            <Button x:Name="BtnImportLicense" Background="#00897B" Foreground="White" FontWeight="SemiBold" FontSize="14"
                                    Padding="20,10" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center"
                                    Command="{Binding License.ImportLicenseFileCommand}"/>

                            <Button x:Name="BtnRefreshLicense" Background="#546E7A" Foreground="White" FontWeight="SemiBold" FontSize="13"
                                    Padding="16,7" BorderThickness="0" Cursor="Hand" HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Command="{Binding License.RefreshCommand}"/>

                            <TextBlock x:Name="LblLicenseStatus" Text="{Binding License.StatusMessage}" FontSize="12" Foreground="#00695C"
                               HorizontalAlignment="Center" Margin="0,12,0,0" TextWrapping="Wrap" MaxWidth="560"/>

                        </StackPanel>
                    </TabItem>

                </TabControl>

                <TextBlock Text="{Binding StatusMessage}" FontSize="12" Foreground="#00897B" HorizontalAlignment="Center" Margin="0,10,0,0" TextWrapping="Wrap"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
