                    <ComboBoxItem Content="&#x0627;&#x0633;&#x062A;&#x062D;&#x0642;&#x0627;&#x0642;&#x064A; (Accrual)" Tag="accrual"/>
                    <ComboBoxItem Content="&#x0646;&#x0642;&#x062F;&#x064A; (Cash)" Tag="cash"/>
