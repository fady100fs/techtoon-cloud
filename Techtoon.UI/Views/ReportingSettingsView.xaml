                <TextBlock Grid.Row="0" Grid.Column="0" Text="&#x0627;&#x0644;&#x0623;&#x0633;&#x0627;&#x0633; &#x0627;&#x0644;&#x0645;&#x062D;&#x0627;&#x0633;&#x0628;&#x064A;:" VerticalAlignment="Center" FontWeight="SemiBold"/>
