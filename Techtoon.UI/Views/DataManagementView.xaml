<UserControl x:Class="Techtoon.UI.Views.DataManagementView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <UserControl.Resources>
        <!-- بطاقة مجموعة حذف -->
        <DataTemplate x:Key="GroupCardTemplate">
            <Border Background="White" CornerRadius="8" Padding="15" Margin="5"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="Bold"
                               Foreground="#37474F" Margin="0,0,0,6" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#546E7A"
                               Margin="0,0,0,10" TextWrapping="Wrap"/>
                    <Button Content="&#x645;&#x639;&#x627;&#x64A;&#x646;&#x629; &#x648;&#x62D;&#x630;&#x641;"
                            Command="{Binding DataContext.DeleteGroupCommand,
                                              RelativeSource={RelativeSource AncestorType=UserControl}}"
                            CommandParameter="{Binding}"
                            Style="{StaticResource PrimaryButton}" HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="&#x625;&#x62F;&#x631;&#x629; &#x627;&#x644;&#x628;&#x64A;&#x627;&#x646;&#x627;&#x62A; &#x648;&#x625;&#x639;&#x627;&#x62F;&#x629; &#x636;&#x628;&#x637; &#x627;&#x644;&#x645;&#x635;&#x646;&#x639;"
                       FontSize="22" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,10"/>
            <TextBlock Text="&#x627;&#x643;&#x644; &#x627;&#x644;&#x628;&#x64A;&#x627;&#x646;&#x627;&#x62A; &#x644;&#x64A;&#x62F;&#x627;&#x632;&#x64A;&#x627;&#x646;&#x627; &#x627;&#x644;&#x645;&#x63A;&#x631;&#x643;&#x629;&#x627; &#x623;&#x644;&#x649; &#x62C;&#x632;&#x625; &#x645;&#x646; &#x627;&#x644;&#x628;&#x64A;&#x627;&#x646;&#x627;&#x62A;&#x60; &#x623;&#x644;&#x649; &#x627;&#x644;&#x633;&#x62C;&#x644;&#x627;&#x62A; &#x627;&#x644;&#x62C;&#x644;&#x637;&#x629;."
                       FontSize="13" Foreground="#546E7A" Margin="0,0,0,15" TextWrapping="Wrap"/>

            <!-- Warning Banner -->
            <Border Background="#FFEBEE" BorderBrush="#C62828" BorderThickness="2" CornerRadius="6" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="&#x26A0;&#xFE0F; &#x62A;&#x62D;&#x630;&#x64A;&#x631;: &#x623;&#x639;&#x64A;&#x644;&#x64A;&#x639; &#x645;&#x644;&#x64A;&#x639; &#x62D;&#x630;&#x641; &#x644;&#x627; &#x62A;&#x645;&#x62A; &#x627;&#x644;&#x639;&#x648;&#x62F;&#x629;."
                               FontSize="16" FontWeight="Bold" Foreground="#C62828" Margin="0,0,0,5"/>
                    <TextBlock Text="&#x64A;&#x62C;&#x628; &#x625;&#x646;&#x634;&#x627;&#x621; &#x646;&#x633;&#x62E;&#x629; &#x627;&#x62D;&#x62A;&#x64A;&#x627;&#x636;&#x627;&#x629;&#x629; &#x642;&#x628;&#x644; &#x623;&#x639;&#x645;&#x644;&#x64A;&#x639;. &#x633;&#x64A;&#x62A;&#x645; &#x637;&#x644;&#x628; &#x627;&#x644;&#x62A;&#x623;&#x643;&#x64A;&#x62F; &#x645;&#x631;&#x62A;&#x64A;&#x646; &#x645;&#x639;&#x627;&#x644;&#x644;&#x64A;&#x629;&#x64A;&#x629;."
                               FontSize="13" Foreground="#B71C1C" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <!-- ============ حذف جزئي ============ -->
            <Border Background="White" CornerRadius="8" Padding="18" Margin="0,0,0,20"
                    BorderBrush="#E0E0E0" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="&#x62D;&#x630;&#x641; &#x62C;&#x632;&#x626;&#x64A; &#x645;&#x646; &#x627;&#x644;&#x628;&#x64A;&#x627;&#x646;&#x627;&#x62A;"
                               FontSize="17" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,5"/>
                    <TextBlock Text="&#x627;&#x62D;&#x630;&#x641; &#x62C;&#x6232;&#x626;&#x647; &#x645;&#x646; &#x627;&#x644;&#x628;&#x64A;&#x627;&#x646;&#x627;&#x62A; &#x62A;&#x62D;&#x62AF;&#x631; &#x623;&#x631;&#x627;&#x62A;&#x627;&#x60; &#x623;&#x644;&#x649; &#x62C;&#x62D;&#x62AF; &#x627;&#x644;&#x645;&#x62C;&#x644;&#x63A;&#x627;&#x62A; &#x645;&#x639;&#x62F;&#x64A;&#x64A;&#x62A; &#x623;&#x62A;&#x62D;&#x62AF;&#x64A;&#x63A;."
                               FontSize="12" Foreground="#546E7A" Margin="0,0,0,12" TextWrapping="Wrap"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="&#x62D;&#x630;&#x641; &#x628;&#x64A;&#x627;&#x646;&#x627;&#x62A; &#x639;&#x645;&#x64A;&#x644;"
                                Command="{Binding DeletePartyDataCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                        <Button Content="&#x62D;&#x630;&#x641; &#x627;&#x644;&#x62D;&#x631;&#x643;&#x627;&#x62A; &#x642;&#x628;&#x644; &#x62A;&#x627;&#x62C;&#x64A;&#x62E;"
                                Command="{Binding DeleteBeforeDateCommand}"
                                Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ المجموعات (تُبنى ديناميكياً) ============ -->
            <ItemsControl ItemsSource="{Binding Categories}" Margin="0,0,0,20">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,18">
                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="Bold"
                                       Foreground="#37474F" Margin="8,0,0,8"/>
                            <ItemsControl ItemsSource="{Binding Groups}"
                                          ItemTemplate="{StaticResource GroupCardTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Factory Reset Section -->
            <Border Background="#FFF3E0" BorderBrush="#EF6C00" BorderThickness="2" CornerRadius="8" Padding="20" Margin="0,10,0,0">
                <StackPanel>
                    <TextBlock Text="&#x625;&#x639;&#x627;&#x62F;&#x629; &#x636;&#x628;&#x637; &#x627;&#x644;&#x645;&#x635;&#x646;&#x639; (Factory Reset)"
                               FontSize="18" FontWeight="Bold" Foreground="#E65100" Margin="0,0,0,10"/>
                    <TextBlock Text="&#x647;&#x630;&#x647; &#x627;&#x644;&#x639;&#x645;&#x644;&#x64A;&#x639; &#x62A;&#x62D;&#x630;&#x641; &#x62C;&#x645;&#x64A;&#x639; &#x628;&#x64A;&#x627;&#x646;&#x627;&#x62A; &#x627;&#x644;&#x639;&#x645;&#x644; &#x648;&#x62A;&#x647;&#x64A;&#x626; &#x627;&#x644;&#x646;&#x638;&#x627;&#x645; &#x644;&#x644;&#x628;&#x62F;&#x621; &#x645;&#x646; &#x62C;&#x62F;&#x64A;&#x62F;. &#x633;&#x64A;&#x62A;&#x645; &#x627;&#x644;&#x627;&#x62D;&#x62A;&#x641;&#x627;&#x638; &#x628;&#x627;&#x644;&#x645;&#x633;&#x62A;&#x62D;&#x62F;&#x645; &#x627;&#x644;&#x625;&#x62F;&#x627;&#x631;&#x64A; &#x648;&#x627;&#x644;&#x623;&#x62F;&#x648;&#x627;&#x621;."
                               FontSize="13" Foreground="#BF360C" Margin="0,0,0,15" TextWrapping="Wrap"/>
                    <Button Content="&#x625;&#x639;&#x627;&#x62F;&#x629; &#x636;&#x628;&#x637; &#x627;&#x644;&#x645;&#x635;&#x646;&#x639;"
                            Command="{Binding FactoryResetCommand}" Background="#FFEF6C00" Foreground="White"
                            FontWeight="Bold" Padding="20,10" BorderThickness="0" FontSize="14"
                            HorizontalAlignment="Right"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
