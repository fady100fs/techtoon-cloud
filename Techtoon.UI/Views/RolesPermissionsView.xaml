<UserControl x:Class="Techtoon.UI.Views.RolesPermissionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- &#x0627;&#x0644;&#x062A;&#x0631;&#x0648;&#x064A;&#x0633;&#x0629; -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="&#x0627;&#x0644;&#x0623;&#x062F;&#x0648;&#x0627;&#x0631; &#x0648;&#x0627;&#x0644;&#x0635;&#x0644;&#x0627;&#x062D;&#x064A;&#x0627;&#x062A;" FontSize="20" FontWeight="Bold" Foreground="#00695C"/>
                <TextBlock Text="&#x0643;&#x0644; &#x0645;&#x0633;&#x062A;&#x062E;&#x062F;&#x0645; &#x0644;&#x0647; &#x062F;&#x0648;&#x0631; &#x0648;&#x0627;&#x062D;&#x062F;&#x060C; &#x0648;&#x0627;&#x0644;&#x062F;&#x0648;&#x0631; &#x064A;&#x062D;&#x062F;&#x062F; &#x0627;&#x0644;&#x0635;&#x0641;&#x062D;&#x0627;&#x062A; &#x0648;&#x0627;&#x0644;&#x0635;&#x0644;&#x0627;&#x062D;&#x064A;&#x0627;&#x062A; &#x0627;&#x0644;&#x0638;&#x0627;&#x0647;&#x0631;&#x0629; &#x0644;&#x0647;. &#x0627;&#x0633;&#x062A;&#x062B;&#x0646;&#x0627;&#x0621;&#x0627;&#x062A; &#x0627;&#x0644;&#x0645;&#x0633;&#x062A;&#x062E;&#x062F;&#x0645; (&#x0645;&#x0646;&#x062D;/&#x0645;&#x0646;&#x0639;) &#x062A;&#x0633;&#x0628;&#x0642; &#x0627;&#x0644;&#x062F;&#x0648;&#x0631;."
                           FontSize="11" Foreground="#607D8B" TextWrapping="Wrap" Margin="0,3,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Content="&#x062A;&#x062D;&#x062F;&#x064A;&#x062B;" Background="#26A69A" Foreground="White" FontWeight="SemiBold"
                    Padding="14,8" BorderThickness="0" Cursor="Hand" Command="{Binding RefreshCommand}"/>
        </Grid>

        <TabControl Grid.Row="1" FontSize="13" Background="White" BorderBrush="#E0E0E0">

            <!-- ============ &#x062A;&#x0628;&#x0648;&#x064A;&#x0628; &#x0627;&#x0644;&#x0623;&#x062F;&#x0648;&#x0627;&#x0631; ============ -->
            <TabItem Header="&#x0627;&#x0644;&#x0623;&#x062F;&#x0648;&#x0627;&#x0631;">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- &#x0642;&#x0627;&#x0626;&#x0645;&#x0629; &#x0627;&#x0644;&#x0623;&#x062F;&#x0648;&#x0627;&#x0631; -->
                    <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <Button Content="&#x062F;&#x0648;&#x0631; &#x062C;&#x062F;&#x064A;&#x062F;" Background="#00897B" Foreground="White" FontWeight="SemiBold"
                                        Padding="10,6" BorderThickness="0" Cursor="Hand" Command="{Binding NewRoleCommand}"/>
                                <Button Content="&#x062A;&#x0639;&#x062F;&#x064A;&#x0644;" Background="#1565C0" Foreground="White" FontWeight="SemiBold"
                                        Padding="10,6" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" Command="{Binding EditRoleCommand}"/>
                                <Button Content="&#x062D;&#x0630;&#x0641;" Background="#C62828" Foreground="White" FontWeight="SemiBold"
                                        Padding="10,6" BorderThickness="0" Cursor="Hand" Margin="6,0,0,0" Command="{Binding DeleteRoleCommand}"/>
                            </StackPanel>
                            <ListBox ItemsSource="{Binding Roles}" SelectedItem="{Binding SelectedRole}" BorderThickness="0" Background="Transparent" HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,6">
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="Bold" FontSize="13" Foreground="#00695C"/>
                                            <TextBlock Text="{Binding Name}" FontSize="10" Foreground="#90A4AE"/>
                                            <TextBlock FontSize="10" Foreground="#78909C">
                                                <Run Text="{Binding PermissionCount, Mode=OneWay}"/>
                                                <Run Text="&#x0635;&#x0644;&#x0627;&#x062D;&#x064A;&#x0629;"/>
                                                <Run Text="&#x2022;"/>
                                                <Run Text="{Binding UserCount, Mode=OneWay}"/>
                                                <Run Text="&#x0645;&#x0633;&#x062A;&#x062E;&#x062F;&#x0645;"/>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>

                    <!-- &#x0645;&#x0635;&#x0641;&#x0648;&#x0641;&#x0629; &#x0635;&#x0644;&#x0627;&#x062D;&#x064A;&#x0627;&#x062A; &#x0627;&#x0644;&#x062F;&#x0648;&#x0631; -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#x0635;&#x0644;&#x0627;&#x062D;&#x064A;&#x0627;&#x062A; &#x0627;&#x0644;&#x062F;&#x0648;&#x0631;" FontSize="14" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedRole.DisplayName}" FontSize="14" FontWeight="Bold" Foreground="#00897B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Button Content="&#x062A;&#x062D;&#x062F;&#x064A;&#x062F; &#x0627;&#x0644;&#x0643;&#x0644;" Padding="10,5" BorderThickness="0" Background="#455A64" Foreground="White" Margin="20,0,0,0" Command="{Binding SelectAllCommand}"/>
                                <Button Content="&#x0625;&#x0644;&#x063A;&#x0627;&#x0621; &#x0627;&#x0644;&#x0643;&#x0644;" Padding="10,5" BorderThickness="0" Background="#78909C" Foreground="White" Margin="6,0,0,0" Command="{Binding ClearAllCommand}"/>
                                <Button Content="&#x062D;&#x0641;&#x0638; &#x0635;&#x0644;&#x0627;&#x062D;&#x064A;&#x0627;&#x062A; &#x0627;&#x0644;&#x062F;&#x0648;&#x0631;" Padding="14,6" BorderThickness="0" Background="#2E7D32" Foreground="White" FontWeight="SemiBold" Margin="10,0,0,0" Command="{Binding SaveRolePermissionsCommand}"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding PermissionGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding ModuleLabel}" IsExpanded="True" FontWeight="Bold" Foreground="#00695C" Margin="0,4,0,0">
                                                <ItemsControl ItemsSource="{Binding Items}" Margin="14,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <CheckBox Content="{Binding Label}" IsChecked="{Binding IsChecked, Mode=TwoWay}" Margin="0,3,0,3" FontSize="12"/>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ============ &#x062A;&#x0628;&#x0648;&#x064A;&#x0628; &#x0627;&#x0644;&#x0645;&#x0633;&#x062A;&#x062E;&#x062F;&#x0645;&#x064A;&#x0646; ============ -->
            <TabItem Header="&#x0627;&#x0644;&#x0645;&#x0633;&#x062A;&#x062E;&#x062F;&#x0645;&#x0648;&#x0646;">
                <Grid Margin="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- &#x0642;&#x0627;&#x0626;&#x0645;&#x0629; &#x0627;&#x0644;&#x0645;&#x0633;&#x062A;&#x062E;&#x062F;&#x0645;&#x064A;&#x0646; -->
                    <Border Grid.Column="0" Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,10,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBlock Text="&#x0627;&#x0644;&#x0645;&#x0633;&#x062A;&#x062E;&#x062F;&#x0645;" FontSize="13" FontWeight="Bold" Foreground="#37474F"/>
                                <ListBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" BorderThickness="0" Background="Transparent" Height="240" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="2,5">
                                                <TextBlock Text="{Binding Username}" FontWeight="Bold" FontSize="13"/>
                                                <TextBlock Text="{Binding RoleDisplayName}" FontSize="11" Foreground="#00897B"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Text="&#x0627;&#x0644;&#x062F;&#x0648;&#x0631;" FontSize="13" FontWeight="Bold" Foreground="#37474F" Margin="0,8,0,4"/>
                                <ComboBox ItemsSource="{Binding AssignableRoles}" SelectedItem="{Binding SelectedUserRole}"
                                          DisplayMemberPath="DisplayName" Height="30" FontSize="13"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <!-- &#x0627;&#x0633;&#x062A;&#x062B;&#x0646;&#x0627;&#x0621;&#x0627;&#x062A; &#x0627;&#x0644;&#x0645;&#x0633;&#x062A;&#x062E;&#x062F;&#x0645; -->
                    <Border Grid.Column="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="6" Padding="10">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <TextBlock Text="&#x0627;&#x0633;&#x062A;&#x062B;&#x0646;&#x0627;&#x0621;&#x0627;&#x062A; &#x0627;&#x0644;&#x0645;&#x0633;&#x062A;&#x062E;&#x062F;&#x0645;" FontSize="14" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SelectedUser.Username}" FontSize="14" FontWeight="Bold" Foreground="#00897B" VerticalAlignment="Center" Margin="8,0,0,0"/>
                                <Button Content="&#x062D;&#x0641;&#x0638; &#x0627;&#x0644;&#x0627;&#x0633;&#x062A;&#x062B;&#x0646;&#x0627;&#x0621;&#x0627;&#x062A;" Padding="14,6" BorderThickness="0" Background="#2E7D32" Foreground="White" FontWeight="SemiBold" Margin="20,0,0,0" Command="{Binding SaveUserOverridesCommand}"/>
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding UserOverrideGroups}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Expander Header="{Binding ModuleLabel}" IsExpanded="False" FontWeight="Bold" Foreground="#00695C" Margin="0,4,0,0">
                                                <ItemsControl ItemsSource="{Binding Items}" Margin="14,4,0,0">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Grid Margin="0,3,0,3">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="170"/>
                                                                </Grid.ColumnDefinitions>
                                                                <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="12" VerticalAlignment="Center"/>
                                                                <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.OverrideStates, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  SelectedValuePath="Value" SelectedValue="{Binding State, Mode=TwoWay}"
                                                  DisplayMemberPath="DisplayName" Height="26" FontSize="11"/>
                                                            </Grid>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="12" Foreground="#00695C" Margin="0,8,0,0" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
