<UserControl x:Class="Techtoon.UI.Views.LoansView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <TabControl Margin="6" Background="Transparent">

        <!-- ============ تبويب: سلف الموظفين (مرتبطة بالعهدة) ============ -->
        <TabItem Header="🧑‍💼 سلف الموظفين" FontSize="14" FontWeight="Bold">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="سلف الموظفين (صرف من خزينة + استرداد — الحلقة مغلقة)" FontSize="17" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="🔄 تحديث" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding RefreshAdvancesCmd}"/>
                    <Button Grid.Column="2" Content="➕ صرف سلفة" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding AddAdvanceCmd}"/>
                    <Button Grid.Column="3" Content="↩️ استرداد" Background="#7B1FA2" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding RepayAdvanceCmd}"/>
                    <Button Grid.Column="4" Content="🗑️ حذف" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="10,7" Command="{Binding DeleteAdvanceCmd}"/>
                </Grid>

                <Border Grid.Row="1" Background="White" Padding="8" Margin="0,0,0,6" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍 بحث:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="280"/>
                        <TextBlock Text="{Binding AdvStatus}" Foreground="#00695C" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Advances}" SelectedItem="{Binding SelAdv}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الموظف" Binding="{Binding EmployeeName}" Width="*"/>
                            <DataGridTextColumn Header="العهدة المرتبطة" Binding="{Binding CustodyDisplay}" Width="*"/>
                            <DataGridTextColumn Header="مبلغ السلفة" Binding="{Binding AmountDisplay}" Width="110"/>
                            <DataGridTextColumn Header="المسترد" Binding="{Binding PaidDisplay}" Width="110"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingDisplay}" Width="110"/>
                            <DataGridTextColumn Header="تاريخ الصرف" Binding="{Binding DateDisplay}" Width="110"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </TabItem>

        <!-- ============ تبويب: قروض المنشأة ============ -->
        <TabItem Header="🏦 قروض المنشأة" FontSize="14" FontWeight="Bold">
            <Grid Margin="8">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Content="🔄 تحديث" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding RefreshLoansCmd}"/>
                    <Button Grid.Column="1" Content="➕ إضافة قرض" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding AddLoanCmd}"/>
                    <Button Grid.Column="2" Content="📋 جدول الأقساط" Background="#F57F17" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding ScheduleLoanCmd}"/>
                    <Button Grid.Column="3" Content="✏️ تعديل" Background="#1565C0" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding EditLoanCmd}"/>
                    <Button Grid.Column="4" Content="✅ تسوية/إقفال" Background="#7B1FA2" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding CloseLoanCmd}"/>
                    <Button Grid.Column="5" Content="🗑️ حذف" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="10,7" Command="{Binding DeleteLoanCmd}"/>
                </Grid>

                <Border Grid.Row="1" Background="White" Padding="8" Margin="0,0,0,6" CornerRadius="4">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="🔍 بحث:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox Text="{Binding LoanSearchText, UpdateSourceTrigger=PropertyChanged}" Width="280"/>
                        <TextBlock Text="{Binding LoanStatus}" Foreground="#00695C" FontWeight="SemiBold" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    </StackPanel>
                </Border>

                <Border Grid.Row="3" Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
                    <DataGrid ItemsSource="{Binding Loans}" SelectedItem="{Binding SelLoan}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="الرقم" Binding="{Binding LoanNumber}" Width="90"/>
                            <DataGridTextColumn Header="المُقرض" Binding="{Binding Lender}" Width="*"/>
                            <DataGridTextColumn Header="النوع" Binding="{Binding TypeDisplay}" Width="170"/>
                            <DataGridTextColumn Header="رأس المال" Binding="{Binding PrincipalDisplay}" Width="110"/>
                            <DataGridTextColumn Header="الفائدة" Binding="{Binding RateDisplay}" Width="70"/>
                            <DataGridTextColumn Header="القسط" Binding="{Binding InstallmentDisplay}" Width="100"/>
                            <DataGridTextColumn Header="المسدد" Binding="{Binding PaidDisplay}" Width="110"/>
                            <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingDisplay}" Width="110"/>
                            <DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="70"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </Grid>
        </TabItem>
    </TabControl>
</UserControl>
