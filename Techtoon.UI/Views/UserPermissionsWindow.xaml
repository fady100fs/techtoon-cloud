            <Button Content="&#x625;&#x644;&#x063A;&#x627;&#x621;" Width="100" Height="38" Click="BtnCancel_Click" Background="#FFECEFF1" Foreground="#FF37474F" FontWeight="Bold" BorderThickness="0"/>
        </StackPanel>

        <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="pnlPermissions" Margin="10"/>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>