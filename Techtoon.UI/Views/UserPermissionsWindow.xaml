        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x635;&#x644;&#x627;&#x62D;&#x64A;&#x627;&#x62A;"
        Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        FlowDirection="RightToLeft" FontFamily="Tahoma" Background="#F5F7FA">
    <DockPanel Margin="16">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,12">
            <TextBlock x:Name="lblTitle" Text="&#x635;&#x644;&#x627;&#x62D;&#x64A;&#x627;&#x62A; &#x627;&#x644;&#x645;&#x633;&#x62A;&#x62E;&#x62F;&#x645;" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            <TextBlock x:Name="lblUser" Text="" FontSize="14" Foreground="#546E7A" Margin="0,0,0,6"/>
            <TextBlock Text="&#x0645;&#x0631;&#x0628;&#x0639; &#x0645;&#x0646; &#x0627;&#x0644;&#x062F;&#x0648;&#x0631; = &#x064A;&#x0648;&#x0631;&#x062B; | &#x0645;&#x0645;&#x062D;&#x0648;&#x0642; = &#x0625;&#x0636;&#x0627;&#x0641;&#x0629; &#x0641;&#x0648;&#x0642; &#x0627;&#x0644;&#x062F;&#x0648;&#x0631; | &#x0645;&#x0645;&#x0646;&#x0648;&#x0639; = &#x0633;&#x062D;&#x0628; &#x0627;&#x0644;&#x0635;&#x0644;&#x0627;&#x062D;&#x064A;&#x0629; &#x0631;&#x063A;&#x0645; &#x0627;&#x0644;&#x062F;&#x0648;&#x0631;."
                       FontSize="11" Foreground="#78909C" TextWrapping="Wrap" Margin="0,0,0,4"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
