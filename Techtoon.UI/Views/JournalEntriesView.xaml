<UserControl x:Class="Techtoon.UI.Views.JournalEntriesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#x0627;&#x0644;&#x0642;&#x064A;&#x0648;&#x062F; &#x0627;&#x0644;&#x0645;&#x062D;&#x0627;&#x0633;&#x0628;&#x064A;&#x0629; &#x0627;&#x0644;&#x064A;&#x062F;&#x0648;&#x064A;&#x0629;" FontSize="20" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="&#x062A;&#x062D;&#x062F;&#x064A;&#x062B;" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding RefreshCommand}"/>
            <Button Grid.Column="2" Content="&#x0642;&#x064A;&#x062F; &#x062C;&#x062F;&#x064A;&#x062F;" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding AddCommand}"/>
            <Button Grid.Column="3" Content="&#x062A;&#x0639;&#x062F;&#x064A;&#x0644;" Background="#1565C0" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding EditCommand}"/>
            <Button Grid.Column="4" Content="&#x0639;&#x0631;&#x0636; &#x0627;&#x0644;&#x0628;&#x0646;&#x0648;&#x062F;" Background="#5E35B1" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding ViewCommand}"/>
            <Button Grid.Column="5" Content="&#x062D;&#x0630;&#x0641;" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding DeleteCommand}"/>
        </Grid>

        <TabControl Grid.Row="1" Background="#F5F7FA" BorderBrush="#E0E0E0">
            <TabItem Header="&#x0627;&#x0644;&#x0642;&#x064A;&#x0648;&#x062F; &#x0627;&#x0644;&#x064A;&#x062F;&#x0648;&#x064A;&#x0629;">
                <Border Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Margin="0,8,0,0">
                    <DataGrid x:Name="DgEntries"
                              ItemsSource="{Binding Entries}"
                              SelectedItem="{Binding SelectedEntry}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13"
                              AlternatingRowBackground="#FAFAFA">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="&#x0631;&#x0642;&#x0645; &#x0627;&#x0644;&#x0642;&#x064A;&#x062F;" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="&#x0627;&#x0644;&#x062A;&#x0627;&#x0631;&#x064A;&#x062E;" Binding="{Binding DateDisplay}" Width="100"/>
                            <DataGridTextColumn Header="&#x0627;&#x0644;&#x0648;&#x0635;&#x0641;" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="&#x0627;&#x0644;&#x0645;&#x0635;&#x062F;&#x0631;" Binding="{Binding ReferenceTypeDisplay}" Width="90"/>
                            <DataGridTextColumn Header="&#x0639;&#x062F;&#x062F; &#x0627;&#x0644;&#x0628;&#x0646;&#x0648;&#x062F;" Binding="{Binding LineCount}" Width="90"/>
                            <DataGridTextColumn Header="&#x0625;&#x062C;&#x0645;&#x0627;&#x0644;&#x064A; &#x0627;&#x0644;&#x0645;&#x062F;&#x064A;&#x0646;" Binding="{Binding TotalDebitDisplay}" Width="130"/>
                            <DataGridTextColumn Header="&#x0625;&#x062C;&#x0645;&#x0627;&#x0644;&#x064A; &#x0627;&#x0644;&#x062F;&#x0627;&#x0626;&#x0646;" Binding="{Binding TotalCreditDisplay}" Width="130"/>
                            <DataGridTextColumn Header="&#x0627;&#x0644;&#x062D;&#x0627;&#x0644;&#x0629;" Binding="{Binding BalancedDisplay}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </TabItem>

            <TabItem Header="&#x0645;&#x064A;&#x0632;&#x0627;&#x0646; &#x0627;&#x0644;&#x0645;&#x0631;&#x0627;&#x062C;&#x0639;&#x0629;">
                <Grid Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#x0645;&#x0646; &#x062A;&#x0627;&#x0631;&#x064A;&#x062E;" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <DatePicker SelectedDate="{Binding FromDate}" Width="140" Margin="0,0,16,0"/>
                                <TextBlock Text="&#x0625;&#x0644;&#x0649; &#x062A;&#x0627;&#x0631;&#x064A;&#x062E;" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                                <DatePicker SelectedDate="{Binding ToDate}" Width="140" Margin="0,0,16,0"/>
                                <Button Content="&#x0639;&#x0631;&#x0636; &#x0645;&#x064A;&#x0632;&#x0627;&#x0646; &#x0627;&#x0644;&#x0645;&#x0631;&#x0627;&#x062C;&#x0639;&#x0629;" Background="#1565C0" Foreground="White" FontWeight="SemiBold" Padding="12,6" BorderThickness="0" Cursor="Hand" Command="{Binding RunTrialBalanceCommand}"/>
                            </StackPanel>
                            <TextBlock Text="&#x062A;&#x0646;&#x0628;&#x064A;&#x0647;: &#x0647;&#x0630;&#x0627; &#x0627;&#x0644;&#x062A;&#x0642;&#x0631;&#x064A;&#x0631; &#x0645;&#x0628;&#x0646;&#x064A; &#x0639;&#x0644;&#x0649; &#x0627;&#x0644;&#x0642;&#x064A;&#x0648;&#x062F; &#x0627;&#x0644;&#x064A;&#x062F;&#x0648;&#x064A;&#x0629; &#x0627;&#x0644;&#x0645;&#x0633;&#x062C;&#x0644;&#x0629; &#x0641;&#x064A; &#x062C;&#x062F;&#x0648;&#x0644;&#x064A; journal_entries &#x0648; journal_lines &#x0641;&#x0642;&#x0637;&#x060C; &#x0648;&#x0644;&#x0627; &#x064A;&#x0634;&#x0645;&#x0644; &#x0627;&#x0644;&#x0642;&#x064A;&#x0648;&#x062F; &#x0627;&#x0644;&#x0622;&#x0644;&#x064A;&#x0629; &#x0627;&#x0644;&#x0646;&#x0627;&#x062A;&#x062C;&#x0629; &#x0639;&#x0646; &#x0627;&#x0644;&#x0641;&#x0648;&#x0627;&#x062A;&#x064A;&#x0631; &#x0648;&#x0627;&#x0644;&#x0645;&#x062F;&#x0641;&#x0648;&#x0639;&#x0627;&#x062A;."
                                       Foreground="#616161" FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="1" Background="#E8F5E9" BorderBrush="#A5D6A7" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#x0625;&#x062C;&#x0645;&#x0627;&#x0644;&#x064A; &#x0627;&#x0644;&#x0645;&#x062F;&#x064A;&#x0646;" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TrialTotalDebitDisplay}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                            <TextBlock Text="&#x0625;&#x062C;&#x0645;&#x0627;&#x0644;&#x064A; &#x0627;&#x0644;&#x062F;&#x0627;&#x0626;&#x0646;" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TrialTotalCreditDisplay}" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,24,0"/>
                            <TextBlock Text="&#x062D;&#x0627;&#x0644;&#x0629; &#x0627;&#x0644;&#x062A;&#x0648;&#x0627;&#x0632;&#x0646;" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding TrialBalanceStatusDisplay}" FontWeight="Bold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
                        <DataGrid x:Name="DgTrialBalance"
                                  ItemsSource="{Binding TrialBalanceRows}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13"
                                  AlternatingRowBackground="#FAFAFA">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="&#x0643;&#x0648;&#x062F; &#x0627;&#x0644;&#x062D;&#x0633;&#x0627;&#x0628;" Binding="{Binding Code}" Width="110"/>
                                <DataGridTextColumn Header="&#x0627;&#x0633;&#x0645; &#x0627;&#x0644;&#x062D;&#x0633;&#x0627;&#x0628;" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="&#x0646;&#x0648;&#x0639; &#x0627;&#x0644;&#x062D;&#x0633;&#x0627;&#x0628;" Binding="{Binding TypeDisplay}" Width="120"/>
                                <DataGridTextColumn Header="&#x0625;&#x062C;&#x0645;&#x0627;&#x0644;&#x064A; &#x0627;&#x0644;&#x0645;&#x062F;&#x064A;&#x0646;" Binding="{Binding DebitDisplay}" Width="140"/>
                                <DataGridTextColumn Header="&#x0625;&#x062C;&#x0645;&#x0627;&#x0644;&#x064A; &#x0627;&#x0644;&#x062F;&#x0627;&#x0626;&#x0646;" Binding="{Binding CreditDisplay}" Width="140"/>
                                <DataGridTextColumn Header="&#x0627;&#x0644;&#x0631;&#x0635;&#x064A;&#x062F; (&#x0645;&#x062F;&#x064A;&#x0646; - &#x062F;&#x0627;&#x0626;&#x0646;)" Binding="{Binding BalanceDisplay}" Width="160"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="12" Foreground="#00897B" Margin="0,8,0,0" HorizontalAlignment="Left"/>
    </Grid>
</UserControl>
