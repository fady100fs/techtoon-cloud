<UserControl x:Class="Techtoon.UI.Views.SubscriptionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <Grid Margin="6">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- شريط الأدوات -->
        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="الاشتراكات (خدمات دورية - شهرية/سنوية)" FontSize="17" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="🔄 تحديث" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding RefreshCommand}"/>
            <Button Grid.Column="2" Content="➕ اشتراك جديد" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding AddCommand}"/>
            <Button Grid.Column="3" Content="✏️ تعديل" Background="#1565C0" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding EditCommand}"/>
            <Button Grid.Column="4" Content="⏸️ إيقاف/تفعيل" Background="#F57F17" Foreground="White" FontWeight="SemiBold" Padding="10,7" Margin="3,0" Command="{Binding PauseCommand}"/>
            <Button Grid.Column="5" Content="🗑️ حذف" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="10,7" Command="{Binding DeleteCommand}"/>
        </Grid>

        <!-- جدول الاشتراكات -->
        <Border Grid.Row="1" Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1" Margin="0,0,0,8">
            <DataGrid ItemsSource="{Binding Subscriptions}" SelectedItem="{Binding SelectedSubscription}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="العميل" Binding="{Binding PartyName}" Width="*"/>
                    <DataGridTextColumn Header="الخدمة" Binding="{Binding ServiceName}" Width="*"/>
                    <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountDisplay}" Width="110"/>
                    <DataGridTextColumn Header="الدورية" Binding="{Binding FrequencyDisplay}" Width="80"/>
                    <DataGridTextColumn Header="بداية" Binding="{Binding StartDate, StringFormat=yyyy-MM-dd}" Width="100"/>
                    <DataGridTextColumn Header="الاستحقاق القادم" Binding="{Binding NextDueDisplay}" Width="110"/>
                    <DataGridTextColumn Header="متأخرات" Binding="{Binding OverdueDisplay}" Width="90"/>
                    <DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="80"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="2" Text="{Binding StatusMessage}" FontSize="12" Foreground="#00695C" FontWeight="SemiBold" Margin="2,0,0,4"/>

        <!-- جدول الفترات -->
        <Border Grid.Row="3" Background="White" CornerRadius="4" BorderBrush="#E0E0E0" BorderThickness="1">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="8,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="{Binding PeriodsTitle}" FontSize="14" FontWeight="Bold" Foreground="#37474F" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="💵 سداد الفترة المحددة" Background="#7B1FA2" Foreground="White" FontWeight="SemiBold" Padding="12,6" Margin="3,0" Command="{Binding PayPeriodCommand}"/>
                    <Button Grid.Column="2" Content="🔄 تحديث الفترات" Background="#546E7A" Foreground="White" FontWeight="SemiBold" Padding="12,6" Margin="3,0" Command="{Binding RefreshPeriodsCommand}"/>
                </Grid>
                <DataGrid ItemsSource="{Binding Periods}" SelectedItem="{Binding SelectedPeriod}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="#" Binding="{Binding PeriodNumber}" Width="45"/>
                        <DataGridTextColumn Header="العميل" Binding="{Binding PartyName}" Width="*"/>
                        <DataGridTextColumn Header="الخدمة" Binding="{Binding ServiceName}" Width="*"/>
                        <DataGridTextColumn Header="الاستحقاق" Binding="{Binding DueDateDisplay}" Width="110"/>
                        <DataGridTextColumn Header="المبلغ" Binding="{Binding AmountDisplay}" Width="110"/>
                        <DataGridTextColumn Header="المسدد" Binding="{Binding PaidDisplay}" Width="110"/>
                        <DataGridTextColumn Header="المتبقي" Binding="{Binding RemainingDisplay}" Width="110"/>
                        <DataGridTextColumn Header="الحالة" Binding="{Binding StatusDisplay}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
