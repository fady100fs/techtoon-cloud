<UserControl x:Class="Techtoon.UI.Views.AuditLogView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#x1F4DC; &#x0633;&#x062C;&#x0644; &#x0627;&#x0644;&#x062D;&#x0631;&#x0643;&#x0627;&#x062A; (Audit Log)" FontSize="20" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="&#x1F504; &#x062A;&#x062D;&#x062F;&#x064A;&#x062B;" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="15,8" BorderThickness="0" Cursor="Hand" Command="{Binding RefreshCommand}"/>
        </Grid>
        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F50D; &#x0628;&#x062D;&#x062B;:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="300" Padding="6,4" BorderBrush="#B0BEC5" BorderThickness="1"/>
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid ItemsSource="{Binding Logs}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13" AlternatingRowBackground="#FAFAFA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x062A;&#x0627;&#x0631;&#x064A;&#x062E; &#x0648;&#x0627;&#x0644;&#x0648;&#x0642;&#x062A;" Binding="{Binding CreatedAt, StringFormat=yyyy-MM-dd HH:mm:ss}" Width="160"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0645;&#x0633;&#x062A;&#x062E;&#x062F;&#x0645;" Binding="{Binding UserName}" Width="120"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0639;&#x0645;&#x0644;&#x064A;&#x0629;" Binding="{Binding ActionDisplay}" Width="100"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0646;&#x0648;&#x0639;" Binding="{Binding EntityType}" Width="150"/>
                    <DataGridTextColumn Header="ID" Binding="{Binding EntityId}" Width="60"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x062A;&#x0641;&#x0627;&#x0635;&#x064A;&#x0644;" Binding="{Binding Details}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
        <Grid Grid.Row="3" Margin="0,10,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <Button Content="&#x627;&#x644;&#x633;&#x627;&#x628;&#x642;" Command="{Binding PrevPageCommand}" Width="90" Height="30" Margin="0,0,8,0" Padding="10,0" FontWeight="SemiBold" Background="#ECEFF1" BorderThickness="0"/>
                <TextBlock Text="{Binding PageInfo}" VerticalAlignment="Center" Margin="0,0,8,0" FontSize="13" Foreground="#37474F"/>
                <Button Content="&#x627;&#x644;&#x62A;&#x627;&#x644;&#x64A;" Command="{Binding NextPageCommand}" Width="90" Height="30" Padding="10,0" FontWeight="SemiBold" Background="#ECEFF1" BorderThickness="0"/>
            </StackPanel>
        </Grid>
        <TextBlock Grid.Row="0" Grid.RowSpan="4" Text="{Binding StatusMessage}" FontSize="12" Foreground="#00897B" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,5"/>
    </Grid>
</UserControl>
