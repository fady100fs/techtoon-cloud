<UserControl x:Class="Techtoon.UI.Views.BudgetsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FlowDirection="RightToLeft" Background="#F5F7FA" FontFamily="Tahoma">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="230"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="&#x1F4B0; &#x0627;&#x0644;&#x0645;&#x064A;&#x0632;&#x0627;&#x0646;&#x064A;&#x0627;&#x062A;" FontSize="20" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="&#x1F504; &#x062A;&#x062D;&#x062F;&#x064A;&#x062B;" Background="#26A69A" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding RefreshCommand}"/>
            <Button Grid.Column="2" Content="&#x2795; &#x0625;&#x0636;&#x0627;&#x0641;&#x0629;" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding AddCommand}"/>
            <Button Grid.Column="3" Content="&#x270F;&#xFE0F; &#x062A;&#x0639;&#x062F;&#x064A;&#x0644;" Background="#1565C0" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Margin="3,0" Command="{Binding EditCommand}"/>
            <Button Grid.Column="4" Content="&#x1F5D1;&#xFE0F; &#x062D;&#x0630;&#x0641;" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="10,8" BorderThickness="0" Cursor="Hand" Command="{Binding DeleteCommand}"/>
        </Grid>

        <Border Grid.Row="1" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,0,0,10">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#x1F50D; &#x0628;&#x062D;&#x062B;:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold"/>
                <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Width="230" Padding="6,4" BorderBrush="#B0BEC5" BorderThickness="1"/>
                <Separator Width="18" Background="Transparent"/>
                <TextBlock Text="&#x0627;&#x0644;&#x0634;&#x0647;&#x0631;:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Months}" SelectedItem="{Binding SelectedMonth}" Width="100" Padding="4,3" BorderBrush="#B0BEC5" BorderThickness="1"/>
                <TextBlock Text="&#x0627;&#x0644;&#x0633;&#x0646;&#x0629;:" VerticalAlignment="Center" Margin="10,0,6,0" FontWeight="SemiBold"/>
                <ComboBox ItemsSource="{Binding Years}" SelectedItem="{Binding SelectedYear}" Width="90" Padding="4,3" BorderBrush="#B0BEC5" BorderThickness="1"/>
                <Button Content="&#x1F4CA; &#x062A;&#x0642;&#x0631;&#x064A;&#x0631; &#x0627;&#x0644;&#x0645;&#x0642;&#x0627;&#x0631;&#x0646;&#x0629;" Background="#6A1B9A" Foreground="White" FontWeight="SemiBold" Padding="10,6" BorderThickness="0" Cursor="Hand" Margin="12,0,0,0" Command="{Binding ReportCommand}"/>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="DgBudgets" ItemsSource="{Binding Budgets}" SelectedItem="{Binding SelectedItem}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13" AlternatingRowBackground="#FAFAFA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                    <DataGridTextColumn Header="&#x0643;&#x0648;&#x062F; &#x0627;&#x0644;&#x062D;&#x0633;&#x0627;&#x0628;" Binding="{Binding AccountCode}" Width="110"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x062D;&#x0633;&#x0627;&#x0628;" Binding="{Binding AccountName}" Width="*"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0634;&#x0647;&#x0631;" Binding="{Binding MonthName}" Width="100"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0633;&#x0646;&#x0629;" Binding="{Binding Year}" Width="80"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0645;&#x0628;&#x0644;&#x063A; &#x0627;&#x0644;&#x0645;&#x064A;&#x0632;&#x0627;&#x0646;&#x064A;" Binding="{Binding AmountDisplay}" Width="140"/>
                    <DataGridTextColumn Header="&#x0645;&#x0644;&#x0627;&#x062D;&#x0638;&#x0627;&#x062A;" Binding="{Binding Notes}" Width="180"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,5">
            <TextBlock Text="&#x1F4CA; &#x0627;&#x0644;&#x0645;&#x064A;&#x0632;&#x0627;&#x0646;&#x064A;&#x0629; &#x0645;&#x0642;&#x0627;&#x0628;&#x0644; &#x0627;&#x0644;&#x0641;&#x0639;&#x0644;&#x064A;:" FontSize="14" FontWeight="Bold" Foreground="#00695C" VerticalAlignment="Center" Margin="0,0,10,0"/>
            <TextBlock Text="{Binding ReportSummary}" FontSize="13" Foreground="#37474F" VerticalAlignment="Center"/>
        </StackPanel>

        <Border Grid.Row="4" Background="White" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4">
            <DataGrid x:Name="DgBudgetReport" ItemsSource="{Binding ReportRows}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" HeadersVisibility="Column" GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEFF1" Background="White" FontSize="13" AlternatingRowBackground="#FAFAFA">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="&#x0643;&#x0648;&#x062F; &#x0627;&#x0644;&#x062D;&#x0633;&#x0627;&#x0628;" Binding="{Binding AccountCode}" Width="110"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x062D;&#x0633;&#x0627;&#x0628;" Binding="{Binding AccountName}" Width="*"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0645;&#x064A;&#x0632;&#x0627;&#x0646;&#x064A;&#x0629;" Binding="{Binding BudgetedDisplay}" Width="140"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0645;&#x0635;&#x0631;&#x0648;&#x0641; &#x0627;&#x0644;&#x0641;&#x0639;&#x0644;&#x064A;" Binding="{Binding ActualDisplay}" Width="140"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0641;&#x0631;&#x0642;" Binding="{Binding DifferenceDisplay}" Width="140"/>
                    <DataGridTextColumn Header="&#x0627;&#x0644;&#x0646;&#x062A;&#x064A;&#x062C;&#x0629;" Binding="{Binding ResultDisplay}" Width="140"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <TextBlock Grid.Row="0" Grid.RowSpan="5" Text="{Binding StatusMessage}" FontSize="12" Foreground="#00897B" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="10,0,0,5"/>
    </Grid>
</UserControl>
