<Window x:Class="Techtoon.UI.Views.BankReconciliationEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x062A;&#x0633;&#x0648;&#x064A;&#x0629; &#x0628;&#x0646;&#x0643;&#x064A;&#x0629;" Height="650" Width="600"
        WindowStartupLocation="CenterScreen"
        Background="#F5F7FA" FontFamily="Tahoma"
        FlowDirection="RightToLeft"
        Loaded="Window_Loaded">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="LblTitle" Grid.Row="0" FontSize="20" FontWeight="Bold" Foreground="#00695C" Margin="0,0,0,15"/>
        <Border Grid.Row="1" Background="White" CornerRadius="6" Padding="15">
            <StackPanel>
                <StackPanel Grid.Row="0" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblCB" Grid.Column="0" Text="&#x0627;&#x0644;&#x062D;&#x0633;&#x0627;&#x0628; &#x0627;&#x0644;&#x0628;&#x0646;&#x0643;&#x064A;:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <ComboBox x:Name="CmbCB" Grid.Column="1" Padding="6,4" FontSize="14" DisplayMemberPath="Name"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="1" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblPS" Grid.Column="0" Text="&#x0628;&#x062F;&#x0627;&#x064A;&#x0629; &#x0627;&#x0644;&#x0641;&#x062A;&#x0631;&#x0629;:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <DatePicker x:Name="DpPS" Grid.Column="1" Padding="6,4" FontSize="14"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="2" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblPE" Grid.Column="0" Text="&#x0646;&#x0647;&#x0627;&#x064A;&#x0629; &#x0627;&#x0644;&#x0641;&#x062A;&#x0631;&#x0629;:" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <DatePicker x:Name="DpPE" Grid.Column="1" Padding="6,4" FontSize="14"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="3" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblOBB" Grid.Column="0" Text="&#x0631;&#x0635;&#x064A;&#x062F; &#x0628;&#x062F;&#x0627;&#x064A;&#x0629; (&#x0646;&#x0638;&#x0627;&#x0645;):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtOBB" Grid.Column="1" Padding="6,4" FontSize="14"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="4" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblOBank" Grid.Column="0" Text="&#x0631;&#x0635;&#x064A;&#x062F; &#x0628;&#x062F;&#x0627;&#x064A;&#x0629; (&#x0628;&#x0646;&#x0643;):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtOBank" Grid.Column="1" Padding="6,4" FontSize="14"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="5" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblCBB" Grid.Column="0" Text="&#x0631;&#x0635;&#x064A;&#x062F; &#x0646;&#x0647;&#x0627;&#x064A;&#x0629; (&#x0646;&#x0638;&#x0627;&#x0645;):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtCBB" Grid.Column="1" Padding="6,4" FontSize="14"/>
                    </Grid>
                </StackPanel>
                <StackPanel Grid.Row="6" Margin="0,0,0,10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="200"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="LblCBank" Grid.Column="0" Text="&#x0631;&#x0635;&#x064A;&#x062F; &#x0646;&#x0647;&#x0627;&#x064A;&#x0629; (&#x0628;&#x0646;&#x0643;):" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <TextBox x:Name="TxtCBank" Grid.Column="1" Padding="6,4" FontSize="14"/>
                    </Grid>
                </StackPanel>
            </StackPanel>
        </Border>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15,0,0">
            <Button x:Name="BtnSave" Content="&#x1F4BE; &#x062D;&#x0641;&#x0638;" Background="#00897B" Foreground="White" FontWeight="SemiBold" Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" Click="BtnSave_Click"/>
            <Button x:Name="BtnDelete" Content="&#x1F5D1;&#xFE0F; &#x062D;&#x0630;&#x0641;" Background="#E53935" Foreground="White" FontWeight="SemiBold" Padding="20,10" BorderThickness="0" Cursor="Hand" Margin="0,0,15,0" Click="BtnDelete_Click"/>
            <Button x:Name="BtnCancel" Content="&#x2716; &#x0625;&#x0644;&#x063A;&#x0627;&#x0621;" Background="#757575" Foreground="White" FontWeight="SemiBold" Padding="20,10" BorderThickness="0" Cursor="Hand" Click="BtnCancel_Click"/>
        </StackPanel>
        <TextBlock x:Name="LblStatus" Grid.Row="3" FontSize="13" Foreground="#E53935" Margin="0,10,0,0" TextWrapping="Wrap"/>
    </Grid>
</Window>